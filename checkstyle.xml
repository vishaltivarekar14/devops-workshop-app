<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  WORKSHOP CHECKSTYLE RULES
  ─────────────────────────
  Checkstyle enforces a coding standard so that all code in a team looks
  consistent — regardless of who wrote it. Think of it as an automated
  code-style reviewer that runs in your CI pipeline.

  These rules enforce a simple, industry-style Java standard suitable
  for a team project. The pipeline will FAIL if any rule is violated.
-->

<module name="Checker">

    <!-- Enforce UTF-8 file encoding -->
    <property name="charset" value="UTF-8"/>

    <!-- Maximum line length: 120 characters -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <!-- No trailing whitespace at end of lines -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <module name="TreeWalker">

        <!-- ── Naming Conventions ── -->
        <!-- Class names must be UpperCamelCase -->
        <module name="TypeName"/>

        <!-- Method names must be lowerCamelCase -->
        <module name="MethodName"/>

        <!-- Variable names must be lowerCamelCase -->
        <module name="LocalVariableName"/>

        <!-- Constants (static final) must be UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>

        <!-- Package names must be all lowercase -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- ── Imports ── -->
        <!-- No wildcard imports (import java.util.*) -->
        <module name="AvoidStarImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- ── Whitespace & Braces ── -->
        <!-- Always use braces for if/for/while even for single statements -->
        <module name="NeedBraces"/>

        <!-- Opening brace on the same line (K&R style) -->
        <module name="LeftCurly"/>

        <!-- ── Code Quality ── -->
        <!-- No empty catch blocks (swallowing exceptions silently) -->
        <module name="EmptyCatchBlock"/>

        <!-- Avoid magic numbers (use named constants) — warn only -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Methods should not be too long -->
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>

        <!-- No System.out.println in production code — use a logger -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out\.println"/>
            <property name="message" value="Use a logger instead of System.out.println."/>
            <property name="ignoreComments" value="true"/>
        </module>

    </module>
</module>
